---
const services = [
  { number: "01", name: "Strategy" },
  { number: "02", name: "Communications" },
  { number: "03", name: "Audience Intelligence" },
  { number: "04", name: "Cultural Insights" },
];
---

<section class="services" id="services">
  <div class="services__header">
    <span class="services__label">What we do</span>
  </div>

  <ul class="services__list">
    {services.map((s) => (
      <li class="service-row">
        <span class="service-row__num">{s.number}</span>
        <span class="service-row__name">{s.name}</span>
        <span class="service-row__arrow" aria-hidden="true">→</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .services {
    background: var(--cloud-white);
    padding: 7rem 3rem 9rem;
  }

  .services__header {
    max-width: 1280px;
    margin: 0 auto 4rem;
  }

  .services__label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--charcoal);
    opacity: 0.4;
  }

  .services__list {
    list-style: none;
    max-width: 1280px;
    margin: 0 auto;
    border-top: 1px solid rgba(203, 190, 255, 0.35);
  }

  .service-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2.5rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid rgba(203, 190, 255, 0.35);
    cursor: default;
    overflow: hidden;
    opacity: 0;
    transform: translateX(-48px);
    transition: padding-left 0.5s cubic-bezier(0.22, 1, 0.36, 1),
                opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .service-row.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  .service-row:nth-child(1) { transition-delay: 0ms; }
  .service-row:nth-child(2) { transition-delay: 100ms; }
  .service-row:nth-child(3) { transition-delay: 200ms; }
  .service-row:nth-child(4) { transition-delay: 300ms; }

  .service-row::before {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--lavender);
    transition: width 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 1;
  }

  .service-row::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 0;
    background: var(--lavender);
    transition: height 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .service-row:hover::before {
    width: 100%;
  }

  .service-row:hover::after {
    height: 100%;
  }

  .service-row:hover {
    padding-left: 1.25rem;
  }

  .service-row__num {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--charcoal);
    opacity: 0.3;
    min-width: 2rem;
    flex-shrink: 0;
    transition: opacity 0.3s ease;
  }

  .service-row:hover .service-row__num {
    opacity: 0.7;
  }

  .service-row__name {
    font-family: var(--font-sans);
    font-size: clamp(2.8rem, 7vw, 8rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--charcoal);
    flex: 1;
    transition: color 0.3s ease;
  }

  .service-row:hover .service-row__name {
    color: rgba(17, 17, 17, 0.75);
  }

  .service-row__arrow {
    font-size: clamp(1.2rem, 2.5vw, 2.5rem);
    color: var(--charcoal);
    opacity: 0;
    transform: translateX(-12px);
    transition: opacity 0.35s ease, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    flex-shrink: 0;
  }

  .service-row:hover .service-row__arrow {
    opacity: 0.4;
    transform: translateX(0);
  }

  @media (max-width: 900px) {
    .services {
      padding: 5rem 1.5rem 7rem;
    }
    .service-row {
      gap: 1.5rem;
      padding: 1.75rem 0;
    }
    .service-row:hover {
      padding-left: 0.5rem;
    }
  }
</style>

<script>
  const rows = document.querySelectorAll<HTMLElement>(".service-row");
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          io.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  rows.forEach((row) => io.observe(row));
</script>
