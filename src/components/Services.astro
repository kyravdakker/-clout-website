---
const services = [
  {
    number: "01",
    title: "Content Performance Analysis",
    description:
      "We decode what resonates — dissecting content at scale to surface patterns, peaks, and missed moments.",
  },
  {
    number: "02",
    title: "Influencer & Creator Analysis",
    description:
      "Beyond follower counts. We map creator ecosystems, audience trust, and cultural alignment to find your real fit.",
  },
  {
    number: "03",
    title: "Customer Behaviour Insights",
    description:
      "Data-led portraits of who your audience actually is — what drives them, what shifts them, what makes them stay.",
  },
  {
    number: "04",
    title: "Campaign Reporting",
    description:
      "Clear, honest read-outs on what worked and why. No vanity metrics, no spin — just signal.",
  },
  {
    number: "05",
    title: "Growth Strategy",
    description:
      "We turn intelligence into direction. Actionable frameworks built for traction, rooted in cultural reality.",
  },
];
---

<section class="services" id="services">
  <div class="services__inner">
    <div class="services__header">
      <p class="label">What we do</p>
      <h2 class="services__heading">
        Five disciplines.<br />One intent.
      </h2>
    </div>

    <div class="services__list">
      {
        services.map((s) => (
          <article class="service-item">
            <span class="service-item__num">{s.number}</span>
            <div class="service-item__body">
              <h3 class="service-item__title">{s.title}</h3>
              <p class="service-item__desc">{s.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--ink);
    padding: 8rem 3rem 9rem;
  }

  .services__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem 6rem;
    align-items: start;
    max-width: 1100px;
    margin: 0 auto;
  }

  .services__header {
    position: sticky;
    top: 8rem;
    align-self: start;
  }

  .label {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--stone);
    margin-bottom: 1.25rem;
    display: block;
  }

  .services__heading {
    font-size: clamp(2.2rem, 3.5vw, 3.4rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--paper);
  }

  .services__list {
    display: flex;
    flex-direction: column;
  }

  .service-item {
    padding: 2.25rem 1rem;
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1.5rem;
    align-items: start;
    border-top: 1px solid rgba(242, 242, 242, 0.08);
    border-radius: 2px;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.3s cubic-bezier(0.22, 1, 0.36, 1),
                background 0.3s ease;
    cursor: default;
  }

  .service-item:last-child {
    border-bottom: 1px solid rgba(242, 242, 242, 0.08);
  }

  .service-item:hover {
    transform: translateY(-3px);
    background: rgba(255, 255, 255, 0.04);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .service-item:hover .service-item__num {
    color: var(--clout-blue);
  }

  .service-item__num {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: rgba(166, 166, 102, 0.7);
    padding-top: 0.2rem;
    transition: color 0.25s ease;
  }

  .service-item__title {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin-bottom: 0.65rem;
    color: var(--paper);
  }

  .service-item__desc {
    font-size: 0.88rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--paper);
    opacity: 0.45;
    max-width: 420px;
  }

  @media (max-width: 900px) {
    .services {
      padding: 5rem 1.5rem 7rem;
    }
    .services__inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .services__header {
      position: static;
    }
    .service-item {
      padding: 2rem 0.5rem;
    }
  }
</style>
