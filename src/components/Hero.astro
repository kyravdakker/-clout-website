---
---

<section class="hero" id="hero">
  <div class="hero__inner">
    <h1 class="hero__wordmark" aria-label="CLOUT">CLOUT</h1>
    <p class="hero__tagline">Insights. Strategy. Impact.</p>
  </div>
  <div class="hero__scroll-hint" aria-hidden="true">
    <span class="hero__scroll-line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--charcoal);
    overflow: hidden;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .hero__wordmark {
    font-family: var(--font-sans);
    font-size: clamp(9rem, 36vw, 54rem);
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 0.9;
    color: var(--cloud-white);
    white-space: nowrap;
    opacity: 0;
    animation: heroFade 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
    will-change: opacity, transform;
  }

  .hero__tagline {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.4vw, 2rem);
    font-weight: 500;
    font-style: italic;
    color: var(--cloud-white);
    opacity: 0;
    margin-top: 2rem;
    letter-spacing: 0.01em;
    animation: taglineFade 1s cubic-bezier(0.16, 1, 0.3, 1) 0.85s forwards;
    will-change: opacity, transform;
  }

  .hero__scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    animation: taglineFade 1s ease 1.6s forwards;
  }

  .hero__scroll-line {
    display: block;
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, transparent, rgba(250, 250, 247, 0.35));
    animation: scrollPulse 2.2s ease-in-out 2s infinite;
  }

  @keyframes heroFade {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes taglineFade {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes scrollPulse {
    0%, 100% { transform: scaleY(1); opacity: 0.4; }
    50%       { transform: scaleY(1.2); opacity: 0.9; }
  }

  @media (max-width: 640px) {
    .hero__wordmark {
      font-size: clamp(6rem, 40vw, 9rem);
    }
    .hero__tagline {
      font-size: clamp(1rem, 4vw, 1.4rem);
      margin-top: 1.5rem;
    }
  }
</style>
