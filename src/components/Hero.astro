---
---

<section class="hero" id="hero">
  <div class="hero__lockup">
    <div class="hero__cloud-wrap">
      <img src="/cloud.png" alt="" class="hero__cloud-img" />
    </div>
    <h1 class="hero__wordmark">C&thinsp;L&thinsp;O&thinsp;U&thinsp;T</h1>
    <p class="hero__tagline">Creative Intelligence. Cultural Impact.</p>
    <p class="hero__statement" id="hero-statement">
      We turn data into culture. Insight into impact.
    </p>
  </div>
</section>

<script>
  const hero = document.getElementById("hero") as HTMLElement;
  const statement = document.getElementById("hero-statement") as HTMLElement;

  // Split statement into word spans
  statement.innerHTML = statement.innerText
    .trim()
    .split(/\s+/)
    .map((w) => `<span class="word">${w}</span>`)
    .join(" ");

  const words = statement.querySelectorAll<HTMLElement>(".word");

  hero.addEventListener("mouseleave", () => {
    words.forEach((w) => (w.style.color = ""));
  });

  hero.addEventListener("mousemove", (e: MouseEvent) => {
    words.forEach((w) => {
      const r = w.getBoundingClientRect();
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      const dist = Math.hypot(e.clientX - cx, e.clientY - cy);
      const t = Math.max(0, 1 - dist / 200);
      if (t > 0.05) {
        const rv = Math.round(10 + t * 26);
        const gv = Math.round(10 + t * 46);
        const bv = Math.round(10 + t * 209);
        w.style.color = `rgb(${rv},${gv},${bv})`;
      } else {
        w.style.color = "";
      }
    });
  });
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8rem 2rem 5rem;
    background: var(--paper);
    overflow: hidden;
  }

  .hero__lockup {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 900px;
  }

  .hero__cloud-wrap {
    width: clamp(110px, 13vw, 190px);
    margin-bottom: 0.9rem;
    opacity: 0;
    animation: fadeUp 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.1s forwards;
  }

  .hero__cloud-img {
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
  }

  .hero__wordmark {
    font-size: clamp(2.2rem, 5vw, 4.5rem);
    font-weight: 900;
    letter-spacing: 0.38em;
    padding-left: 0.38em;
    line-height: 1;
    color: var(--clout-blue);
    margin-bottom: 1.1rem;
    opacity: 0;
    animation: fadeUp 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.22s forwards;
  }

  .hero__tagline {
    font-family: var(--font-display);
    font-size: clamp(0.88rem, 1.2vw, 1.05rem);
    font-weight: 400;
    font-style: italic;
    letter-spacing: 0.01em;
    color: var(--ink);
    margin-bottom: 3.5rem;
    opacity: 0;
    animation: fadeUpMuted 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.34s forwards;
  }

  .hero__statement {
    font-size: clamp(1.5rem, 3vw, 2.6rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--ink);
    max-width: 780px;
    opacity: 0;
    animation: fadeUp 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.48s forwards;
  }

  .hero__statement :global(.word) {
    display: inline-block;
    transition: color 0.2s ease;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeUpMuted {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 0.45; transform: translateY(0); }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 7rem 1.5rem 4rem;
    }
    .hero__cloud-wrap {
      width: 42vw;
    }
    .hero__statement {
      font-size: clamp(1.3rem, 5.5vw, 1.8rem);
    }
  }
</style>
