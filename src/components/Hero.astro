---
---

<section class="hero" id="hero">
  <div class="hero__inner">
    <h1 class="hero__wordmark" aria-label="CLOUT">CLOUT</h1>
    <p class="hero__tagline">Insights. Strategy. Impact.</p>
  </div>
  <div class="hero__scroll-hint" aria-hidden="true">
    <span class="hero__scroll-line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--cloud-white);
    border-bottom: 1px solid rgba(203, 190, 255, 0.3);
    overflow: hidden;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .hero__wordmark {
    font-family: var(--font-sans);
    font-size: clamp(3.5rem, 20vw, 26rem);
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 0.9;
    color: var(--charcoal);
    white-space: nowrap;
    opacity: 0;
    animation: heroFade 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
    will-change: transform;
    transform-origin: center center;
  }

  .hero__tagline {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.4vw, 2rem);
    font-weight: 500;
    font-style: italic;
    color: var(--charcoal);
    opacity: 0;
    margin-top: 2rem;
    letter-spacing: 0.01em;
    animation: taglineFade 1s cubic-bezier(0.16, 1, 0.3, 1) 0.85s forwards;
    will-change: opacity, transform;
  }

  .hero__scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    animation: taglineFade 1s ease 1.6s forwards;
  }

  .hero__scroll-line {
    display: block;
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, transparent, rgba(17, 17, 17, 0.2));
    animation: scrollPulse 2.2s ease-in-out 2s infinite;
  }

  @keyframes heroFade {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes taglineFade {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes scrollPulse {
    0%, 100% { transform: scaleY(1); opacity: 0.4; }
    50%       { transform: scaleY(1.2); opacity: 0.9; }
  }

  @media (max-width: 640px) {
    .hero__tagline {
      font-size: clamp(1rem, 4vw, 1.4rem);
      margin-top: 1.5rem;
    }
  }
</style>

<script>
  (function () {
    const wordmark = document.querySelector<HTMLElement>(".hero__wordmark");
    const hero     = document.getElementById("hero") as HTMLElement;
    if (!wordmark || !hero) return;

    // Activate after the load animation finishes (0.15s delay + 1.1s duration)
    setTimeout(() => {
      let ticking = false;

      const update = () => {
        const heroH    = hero.offsetHeight;
        const progress = Math.min(1, Math.max(0, window.scrollY / heroH));

        // Scale from 1× → 2.5× as you scroll through the hero
        const scale   = 1 + 1.5 * progress;
        // Fade out: fully gone at ~77% scroll so the next section is clean
        const opacity = Math.max(0, 1 - progress * 1.3);

        wordmark.style.transform = `scale(${scale})`;
        wordmark.style.opacity   = String(opacity);
        ticking = false;
      };

      // Sync immediately in case page was loaded mid-scroll
      update();

      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            requestAnimationFrame(update);
            ticking = true;
          }
        },
        { passive: true }
      );
    }, 1300);
  })();
</script>
