---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <span class="footer__wordmark">CLOUT</span>
    <span class="footer__tagline">Insights. Strategy. Impact.</span>
    <span class="footer__copy">© {year} CLOUT Studio · Amsterdam, NL</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--charcoal);
    padding: 2.5rem 3rem;
    border-top: 1px solid rgba(218, 218, 218, 0.08);
  }

  .footer__inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .footer__wordmark {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.3em;
    color: var(--cloud-white);
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .footer__tagline {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-style: italic;
    color: var(--cloud-white);
    opacity: 0.35;
    flex: 1;
  }

  .footer__copy {
    font-size: 0.58rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cloud-white);
    opacity: 0.25;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .footer {
      padding: 2rem 1.5rem;
    }
    .footer__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
