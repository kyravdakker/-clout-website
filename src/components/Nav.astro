    padding: 1.75rem 3rem;
    background: var(--paper);
    border-bottom: 1px solid rgba(10, 10, 10, 0.07);
  }

  .nav__wordmark {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 0.85rem;
