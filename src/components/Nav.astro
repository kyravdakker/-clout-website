---

<nav class="nav">
  <a href="/" class="nav__wordmark">
    <img src="/cloud.png" alt="" class="nav__cloud" />
    CLOUT
  </a>
  <ul class="nav__links">
    <li><a href="#services">Services</a></li>
    <li><a href="#about">About</a></li>
    <li><a href="#contact">Contact</a></li>
  </ul>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 3rem;
    mix-blend-mode: multiply;
  }

  .nav__wordmark {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: 1rem;
    letter-spacing: 0.18em;
    color: var(--ink);
    text-transform: uppercase;
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav__cloud {
    width: 28px;
    height: auto;
    mix-blend-mode: multiply;
    flex-shrink: 0;
  }

  .nav__wordmark:hover {
    color: var(--clout-blue);
  }

  .nav__links {
    display: flex;
    gap: 2.5rem;
    list-style: none;
  }

  .nav__links a {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    position: relative;
    transition: color 0.2s ease;
  }

  .nav__links a::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--clout-blue);
    transition: width 0.3s ease;
  }

  .nav__links a:hover {
    color: var(--clout-blue);
  }

  .nav__links a:hover::after {
    width: 100%;
  }

  @media (max-width: 640px) {
    .nav {
      padding: 1.25rem 1.5rem;
    }
    .nav__links {
      gap: 1.5rem;
    }
  }
</style>
