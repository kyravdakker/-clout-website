---
---

<section class="contact" id="contact">
  <div class="contact__inner">
    <span class="contact__label">Get in touch</span>

    <h2 class="contact__heading">
      Let's build<br />something that matters.
    </h2>

    <a href="mailto:hello@clout.studio" class="contact__email">
      hello@clout.studio
    </a>

    <div class="contact__meta">
      <span>Amsterdam, NL</span>
      <span class="contact__divider">·</span>
      <span>Working globally</span>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--cloud-white);
    color: var(--charcoal);
    padding: 9rem 3rem 8rem;
    min-height: 70svh;
    display: flex;
    align-items: center;
    border-top: 1px solid rgba(203, 190, 255, 0.35);
  }

  .contact__inner {
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .contact__label {
    display: block;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--charcoal);
    opacity: 0.4;
    margin-bottom: 2.5rem;
  }

  .contact__heading {
    font-family: var(--font-sans);
    font-size: clamp(2.2rem, 5.5vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: var(--charcoal);
    margin-bottom: 3.5rem;
  }

  .contact__email {
    font-family: var(--font-sans);
    font-size: clamp(1.1rem, 2.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--charcoal);
    border-bottom: 1.5px solid rgba(17, 17, 17, 0.25);
    padding-bottom: 0.1em;
    transition: color 0.25s ease, border-color 0.25s ease;
    margin-bottom: 3rem;
    display: inline-block;
  }

  .contact__email:hover {
    color: #8b7fd4;
    border-color: var(--lavender);
  }

  .contact__meta {
    display: flex;
    gap: 1rem;
    align-items: center;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--charcoal);
    opacity: 0.3;
  }

  .contact__divider {
    opacity: 0.5;
  }

  @media (max-width: 900px) {
    .contact {
      padding: 6rem 1.5rem 5rem;
    }
  }
</style>
