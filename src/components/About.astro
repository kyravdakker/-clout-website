---
import CloudSVG from "./CloudSVG.astro";
---

<section class="about" id="about">
  <div class="about__inner">
    <div class="about__top">
      <p class="label">Our vision</p>
      <div class="about__cloud">
        <CloudSVG variant="small" />
      </div>
    </div>

    <div class="about__pillars">
      <div class="pillar">
        <span class="pillar__word">Clarity.</span>
      </div>
      <div class="pillar">
        <span class="pillar__word pillar__word--accent">Influence.</span>
      </div>
      <div class="pillar">
        <span class="pillar__word">Culture.</span>
      </div>
    </div>

    <div class="about__body">
      <div class="about__rule" aria-hidden="true"></div>
      <div class="about__text">
        <p>
          CLOUT was built on a simple conviction: that the gap between data and
          instinct is where most brands get lost. We sit in that gap — and we
          work to close it.
        </p>
        <p>
          We blend rigorous analysis with cultural fluency. We read the numbers
          and the room. We find the insight that changes the brief, then build
          the strategy that makes it count.
        </p>
        <p>
          This is intelligence you can feel as much as read. It's the clarity
          that comes from understanding what's really driving behavior — and the
          imagination to know what to do next.
        </p>
      </div>
      <div class="about__details">
        <div class="about__stat">
          <span class="about__stat-num">∞</span>
          <span class="about__stat-label">Data points decoded daily</span>
        </div>
        <div class="about__stat">
          <span class="about__stat-num">01</span>
          <span class="about__stat-label">Question we always start with:<br/>what does this mean?</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--ink);
    color: var(--paper);
    padding: 8rem 3rem 9rem;
    position: relative;
    overflow: hidden;
  }

  /* Subtle blue gradient wash */
  .about::before {
    content: "";
    position: absolute;
    top: -30%;
    right: -10%;
    width: 60%;
    height: 120%;
    background: radial-gradient(ellipse at center, rgba(36, 56, 219, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  .about__inner {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .about__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4rem;
  }

  .label {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--stone);
    display: block;
  }

  .about__cloud {
    width: 180px;
    opacity: 0.35;
    filter: invert(1);
  }

  .about__pillars {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 5rem;
  }

  .pillar {
    border-top: 1px solid rgba(242, 242, 242, 0.1);
    padding: 1rem 0;
  }

  .pillar:last-child {
    border-bottom: 1px solid rgba(242, 242, 242, 0.1);
  }

  .pillar__word {
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--paper);
    display: block;
  }

  .pillar__word--accent {
    color: var(--clout-blue);
  }

  .about__body {
    display: grid;
    grid-template-columns: 1px 1fr 280px;
    gap: 3rem;
    align-items: start;
  }

  .about__rule {
    width: 1px;
    height: 100%;
    background: rgba(242, 242, 242, 0.15);
    align-self: stretch;
  }

  .about__text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about__text p {
    font-size: clamp(1rem, 1.2vw, 1.1rem);
    font-weight: 300;
    line-height: 1.75;
    color: var(--paper);
    opacity: 0.8;
  }

  .about__details {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-top: 0.25rem;
  }

  .about__stat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .about__stat-num {
    font-size: 2.4rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    color: var(--clout-blue);
    line-height: 1;
  }

  .about__stat-label {
    font-size: 0.72rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--paper);
    opacity: 0.5;
    letter-spacing: 0.02em;
  }

  @media (max-width: 900px) {
    .about {
      padding: 5rem 1.5rem 6rem;
    }
    .about__body {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .about__rule {
      display: none;
    }
    .about__details {
      flex-direction: row;
      gap: 2rem;
    }
    .about__cloud {
      display: none;
    }
  }
</style>
