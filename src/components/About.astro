---

<section class="about" id="about">
  <div class="about__inner">
    <span class="about__label">Our approach</span>
    <blockquote class="about__quote">
      We study culture<br />before we build strategy.
    </blockquote>
    <p class="about__sub">
      CLOUT sits at the intersection of data and instinct. We read the numbers
      and the room — and we find the insight that changes the brief.
    </p>
  </div>
</section>

<style>
  .about {
    background: #F3F1F8;
    min-height: 80svh;
    display: flex;
    align-items: center;
    padding: 9rem 3rem;
    border-top: 1px solid rgba(203, 190, 255, 0.35);
    border-bottom: 1px solid rgba(203, 190, 255, 0.35);
  }

  .about__inner {
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
  }

  .about__label {
    display: block;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--charcoal);
    opacity: 0.4;
    margin-bottom: 3.5rem;
  }

  .about__quote {
    font-family: var(--font-playfair);
    font-size: clamp(3rem, 7vw, 9rem);
    font-weight: 700;
    font-style: italic;
    line-height: 1.1;
    color: var(--charcoal);
    letter-spacing: -0.02em;
    border: none;
    padding: 0;
    margin: 0 0 3.5rem;
    max-width: 1000px;
    opacity: 0;
    transform: scale(0.95);
    transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1),
                transform 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .about__quote.is-visible {
    opacity: 1;
    transform: scale(1);
  }

  .about__sub {
    font-size: clamp(0.9rem, 1.4vw, 1.05rem);
    font-weight: 400;
    line-height: 1.85;
    color: var(--charcoal);
    opacity: 0.5;
    max-width: 480px;
  }

  @media (max-width: 900px) {
    .about {
      padding: 6rem 1.5rem;
    }
  }
</style>

<script>
  const quote = document.querySelector<HTMLElement>(".about__quote");
  if (quote) {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          quote.classList.add("is-visible");
          io.disconnect();
        }
      },
      { threshold: 0.25 }
    );
    io.observe(quote);
  }
</script>
