---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "CLOUT — Creative Intelligence Studio",
  description = "We help brands understand culture, uncover opportunities and build relevance through strategy, communications and insights.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,700;0,800;1,400&family=Cormorant+Garamond:ital,wght@1,400;1,500;1,600&family=Playfair+Display:ital,wght@1,700;1,900&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div id="cursor-glow"></div>
    <div id="cursor-dot"></div>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --charcoal:      #111111;
    --cloud-white:   #FAFAF7;
    --midnight-blue: #1D2A52;
    --lavender:      #CBBEFF;
    --stone:         #DADADA;

    --font-sans:     "Plus Jakarta Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
    --font-display:  "Cormorant Garamond", Georgia, "Times New Roman", serif;
    --font-playfair: "Playfair Display", Georgia, "Times New Roman", serif;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    cursor: none !important;
  }

  html {
    font-size: 16px;
    scroll-behavior: smooth;
  }

  body {
    background-color: var(--cloud-white);
    color: var(--charcoal);
    font-family: var(--font-sans);
    font-weight: 400;
    line-height: 1.6;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  ::selection {
    background: var(--lavender);
    color: var(--charcoal);
  }

  img, svg {
    display: block;
    max-width: 100%;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  #cursor-glow {
    position: fixed;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, #CBBEFF 0%, transparent 70%);
    opacity: 0.10;
    mix-blend-mode: screen;
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: left 0.05s linear, top 0.05s linear;
    top: -600px;
    left: -600px;
    z-index: 9999;
  }

  #cursor-dot {
    position: fixed;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1.5px solid #CBBEFF;
    background: transparent;
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: left 0.05s ease, top 0.05s ease;
    top: -20px;
    left: -20px;
    z-index: 10000;
  }
</style>

<script>
  const glow = document.getElementById("cursor-glow") as HTMLElement;
  const dot  = document.getElementById("cursor-dot")  as HTMLElement;

  window.addEventListener("mousemove", (e: MouseEvent) => {
    glow.style.left = e.clientX + "px";
    glow.style.top  = e.clientY + "px";
    dot.style.left  = e.clientX + "px";
    dot.style.top   = e.clientY + "px";
  });
</script>
